              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reference": {
              "type": "string",
              "pattern": "^localhost/ambisgis/[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]{0,100}$"
            },
            "image_id": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "source_manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
