            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "path_profile": {
          "type": "string",
          "enum": [
            "owned-health-timer-ascii-v1"
          ]
        },
        "dns_profile": {
          "type": "string",
          "enum": [
            "native-direct-v1"
          ]
        }
      },
      "required": [
        "podman",
        "compose",
        "environment",
        "files_manifest",
        "prerequisites"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "properties": {
        "database": {
          "type": "object",
          "properties": {
            "archive": {
              "type": "string",
              "minLength": 1
            },
            "archive_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reference": {
              "type": "string",
              "pattern": "^localhost/ambisgis/[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]{0,100}$"
            },
            "image_id": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "source_manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
