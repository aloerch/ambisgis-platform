FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1=IFCPROJECT('0000000000000000000001',$,'Synthetic box',$,$,$,$,(#10),#11);
#2=IFCCARTESIANPOINT((0.,0.,0.));
#3=IFCDIRECTION((0.,0.,1.));
#4=IFCAXIS2PLACEMENT3D(#2,#3,$);
#5=IFCLOCALPLACEMENT($,#4);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,0.00001,#4,$);
#11=IFCUNITASSIGNMENT((#12));
#12=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#18=IFCCARTESIANPOINT((0.,0.));
#19=IFCAXIS2PLACEMENT2D(#18,$);
#20=IFCRECTANGLEPROFILEDEF(.AREA.,'Rectangle',#19,2.,3.);
#22=IFCEXTRUDEDAREASOLID(#20,#4,#3,4.);
#23=IFCSHAPEREPRESENTATION(#10,'Body','SweptSolid',(#22));
#24=IFCPRODUCTDEFINITIONSHAPE($,$,(#23));
