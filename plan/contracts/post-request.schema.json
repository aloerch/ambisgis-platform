{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Proposed post envelope v1",
  "required": [
    "schema_version",
    "accepted_reconcile_id",
    "resolution_revision",
    "expected_branch_head",
    "expected_target_head",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "accepted_reconcile_id": {
      "type": "string",
      "format": "uuid"
    },
    "resolution_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_branch_head": {
      "type": "string",
      "format": "uuid"
    },
    "expected_target_head": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    }
  }
}
