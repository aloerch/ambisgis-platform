{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Proposed atomic edit envelope v1",
  "required": [
    "schema_version",
    "version_group_id",
    "branch_id",
    "expected_head",
    "idempotency_key",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version_group_id": {
      "type": "string",
      "format": "uuid"
    },
    "branch_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_head": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset_id": {
                "type": "string",
                "format": "uuid"
              },
              "feature_id": {
                "type": "string",
                "format": "uuid"
              },
              "op": {
                "const": "add"
              },
              "attributes": {
                "type": "object"
              },
              "geometry": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Full typed geometry validation is performed against the layer schema; no silent CRS/dimension conversion."
              }
            },
            "required": [
              "op",
              "dataset_id",
              "feature_id",
              "attributes"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset_id": {
                "type": "string",
                "format": "uuid"
              },
              "feature_id": {
                "type": "string",
                "format": "uuid"
              },
              "op": {
                "const": "update"
              },
              "attributes": {
                "type": "object"
              },
              "geometry": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Full typed geometry validation is performed against the layer schema; no silent CRS/dimension conversion."
              },
              "expected_feature_revision": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "op",
              "dataset_id",
              "feature_id",
              "expected_feature_revision"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset_id": {
                "type": "string",
                "format": "uuid"
              },
              "feature_id": {
                "type": "string",
                "format": "uuid"
              },
              "op": {
                "const": "delete"
              },
              "expected_feature_revision": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "op",
              "dataset_id",
              "feature_id",
              "expected_feature_revision"
            ]
          }
        ]
      }
    }
  }
}
