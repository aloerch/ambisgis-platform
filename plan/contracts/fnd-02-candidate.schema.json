{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^(aloerch/)?ambisgis-[a-z-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "git_location": {
            "type": "object",
            "properties": {
              "root": {
                "enum": [
                  "platform",
                  "workspace"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "root",
              "path"
            ],
            "additionalProperties": false
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "tag_object": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "provenance": {
            "type": "object"
          },
          "source_binding": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string"
              },
              "pointer": {
                "type": "string"
              }
            },
            "required": [
              "record_id",
              "pointer"
            ]
          }
        },
        "required": [
          "id",
          "repository",
          "commit",
          "version",
          "record_ids",
          "provenance",
          "source_binding"
        ]
      },
      "minItems": 11,
      "maxItems": 11
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "recipe",
              "patch",
              "lock",
              "artifact",
              "evidence",
              "notice",
              "inventory",
              "tool",
              "dependency"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "root": {
                "enum": [
                  "platform",
                  "workspace"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "root",
              "path"
            ],
            "additionalProperties": false
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "owned-source-built",
              "retained-third-party-source",
              "publisher-binary-corresponding-source",
              "generated-shaded-data",
              "unresolved-host-input",
              "publisher-binary-unresolved-source",
              "source-bearing-wheel"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "location",
          "sha256",
          "coverage"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "artifact"
                }
              }
            },
            "then": {
              "required": [
                "producing_record_ids",
                "smoke_record_ids"
              ],
              "properties": {
                "producing_record_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "smoke_record_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "root_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "versions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ordered_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "record_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "order",
                "record_ids",
                "description"
              ]
            }
          }
        },
        "required": [
          "id",
          "root_ids",
          "record_ids",
          "versions",
          "limitations"
        ]
      },
      "minItems": 1
    },
    "combinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string"
                },
                "equals": {},
                "equals_record_sha256": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "record_id",
                "pointer"
              ],
              "oneOf": [
                {
                  "required": [
                    "equals"
                  ],
                  "not": {
                    "required": [
                      "equals_record_sha256"
                    ]
                  }
                },
                {
                  "required": [
                    "equals_record_sha256"
                  ],
                  "not": {
                    "required": [
                      "equals"
                    ]
                  }
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "profile_ids",
          "artifact_ids",
          "evidence_ids",
          "scope",
          "bindings"
        ]
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "resolved",
              "obligation",
              "selection-blocker",
              "investigation",
              "later-gate"
            ]
          },
          "criteria": {
            "type": "array",
            "items": {
              "enum": [
                "C1",
                "C2",
                "C3",
                "C4"
              ]
            },
            "minItems": 1
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "affected": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "record_id"
              ],
              "additionalProperties": false
            }
          },
          "usage": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "established": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "unknown": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "preferred": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "alternatives": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "owner_action": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "approval_excludes": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "closure": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "blocks": {
            "type": "object",
            "properties": {
              "candidate_adoption": {
                "type": "boolean"
              },
              "independent_engineering": {
                "type": "boolean"
              },
              "distribution": {
                "type": "boolean"
              }
            },
            "required": [
              "candidate_adoption",
              "independent_engineering",
              "distribution"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "component",
          "classification",
          "affected",
          "evidence",
          "usage",
          "established",
          "unknown",
          "criteria",
          "gate",
          "preferred",
          "alternatives",
          "owner_action",
          "approval_excludes",
          "closure",
          "record_ids",
          "blocks"
        ]
      }
    },
    "inventories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "root": {
                "enum": [
                  "platform",
                  "workspace"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "root",
              "path"
            ],
            "additionalProperties": false
          },
          "helper": {
            "enum": [
              "qgis",
              "frontend"
            ]
          }
        },
        "required": [
          "id",
          "record_id",
          "pointer",
          "location",
          "helper"
        ],
        "additionalProperties": false
      }
    },
    "archive_members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "archive_id": {
            "type": "string",
            "minLength": 1
          },
          "member": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "archive_id",
          "member",
          "sha256"
        ]
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string"
          },
          "equals": {},
          "equals_record_sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "record_id",
          "pointer"
        ],
        "oneOf": [
          {
            "required": [
              "equals"
            ],
            "not": {
              "required": [
                "equals_record_sha256"
              ]
            }
          },
          {
            "required": [
              "equals_record_sha256"
            ],
            "not": {
              "required": [
                "equals"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "base_commit",
    "roots",
    "records",
    "profiles",
    "combinations",
    "findings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AmbisGIS FND-02 internal candidate manifest (not a comprehensive SBOM)"
}
