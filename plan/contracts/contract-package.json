  "phase_gates": [
    {
      "id": "P0",
      "name": "validate foundations",
      "outcome": "Repos, source/license/dependency evidence, critical spikes, threat/contract decisions",
      "exit_evidence": "Account-safe bootstrap; verified donor baselines and owned initial component builds; source/dependency custody; catalog/map/identity spike; branch reference/DB prototype; QGIS publishing comparison; Project setup/evidence or precisely tracked authorization blockers; ADRs.",
      "accepted": false
    },
    {
      "id": "P1",
      "name": "one cohesive vertical slice",
      "outcome": "Install, identity, catalog, simple service and modern shell",
      "exit_evidence": "From a clean supported host: sign in, publish one synthetic layer, view map/query/metadata, deny a second user, restart successfully. Not yet the full product.",
      "accepted": false
    },
    {
      "id": "P2",
      "name": "service/data lifecycle",
      "outcome": "Native queries/edits, metadata, state-machine publishing, raster baseline, C1 subset",
      "exit_evidence": "No manual upstream configuration; bounded query/edit contracts; failed job recovery; metadata consistency; all advertised C1 operations pass tests.",
      "accepted": false
    },
    {
      "id": "P3",
      "name": "desktop and all requested publication outputs",
      "outcome": "QGIS wizard, fidelity option, stable overwrite, map/feature/raster/vector tiles",
      "exit_evidence": "Publish representative desktop fixtures, compare renderers, interrupt/retry, preserve service/layer IDs, verify permissions and tile assets.",
      "accepted": false
    },
    {
      "id": "P4",
      "name": "branch-style geodatabase",
      "outcome": "Schema semantics, snapshots, edits, reconcile/accept/post, native UI/plugin",
      "exit_evidence": "Full conflict/concurrency/crash/property suite and restored branch post. No Esri branch-protocol claim.",
      "accepted": false
    },
    {
      "id": "P5",
      "name": "modern portal applications",
      "outcome": "Web maps, dashboards, responsive app composer",
      "exit_evidence": "End-user creates a linked map/table/KPI dashboard and responsive app, publishes/rolls back it, passes permission/accessibility tests.",
      "accepted": false
    },
    {
      "id": "P6",
      "name": "notebooks",
      "outcome": "Isolated environments, SDK/catalog/publish, scheduled runs",
      "exit_evidence": "Two-user isolation, pinned spatial image tests, notebook-to-service publishing, revocation, restart and schedule provenance.",
      "accepted": false
    },
    {
      "id": "P7",
      "name": "release hardening",
      "outcome": "Supported installation/upgrade/recovery, measured scale, licenses/security/release",
      "exit_evidence": "Complete capability/ownership acceptance run; upstream-disconnected rebuild and independent patch; security/license approval; actual Project evidence; exact product manifest and recovery record.",
      "accepted": false
    }
  ],
  "compatibility": {
    "native": "authoritative v1 contracts; only explicitly tested bounded spikes implemented",
    "C0": "selected OGC operations only; complete conformance pending",
    "C1": "Koop reuse spike pending; named clients and map export/legend/identify remain required",
    "C2": "later bounded edit facade through native geodatabase; unsupported now",
    "C3": "optional, deferred; native branch semantics remain mandatory"
  },
  "human_only_gates": [
    "WEB-04 manual assistive-technology review",
    "QA-02 representative-user pilot"
  ],
  "supported_product_platforms_required": [
    "single-node Linux server",
    "owned Linux QGIS desktop with bundled plugin",
    "owned Windows QGIS desktop with bundled plugin"
  ]
}
